# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Jina embeddings API key — query encoding. Get one at https://jina.ai/embeddings/
JINA_API_KEY=your_jina_key_here
# Query backend: "api" (default when JINA_API_KEY is set; no local model) or "local".
PARLIAMENT_EMBED_BACKEND=api
# Folder holding de_metadata.parquet and indexes/de_ivfpq.faiss (built via tools/).
PORTABLE_PARLIAMENT_DATA_DIR=./data
